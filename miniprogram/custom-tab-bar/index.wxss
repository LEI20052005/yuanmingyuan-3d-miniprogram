.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #FFFFFF;
  display: flex;
  border-top: 1rpx solid #eeeeee;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  transition: all 0.3s ease;
}

.tab-bar-item.selected {
  transform: scale(1.1);
}

.tab-bar-item.selected .tab-bar-text {
  color: #FF8C00;
  font-weight: bold;
}

.tab-bar-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.tab-bar-item.selected .tab-bar-icon {
  width: 90rpx;
  height: 90rpx;
  filter: drop-shadow(0 0 6rpx rgba(255, 140, 0, 0.4));
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
  line-height: 1;
  transition: all 0.3s ease;
}

.tab-bar-item.selected .tab-bar-text {
  font-size: 24rpx;
}
