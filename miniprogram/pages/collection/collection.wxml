<!-- 藏品列表页 - pages/collection/collection.wxml -->
<!-- 
  页面说明：
  - 2列网格布局展示文物卡片
  - 卡片点击跳转到详情页
  - 底部固定导航栏
-->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">藏品列表</text>
    <text class="subtitle">精选文物</text>
  </view>

  <!-- 文物卡片网格 -->
  <view class="card-grid">
    <view 
      class="card" 
      wx:for="{{collectionList}}" 
      wx:key="id"
      bindtap="goToDetail" 
      data-id="{{item.id}}">
      <!-- 文物图片区域 -->
      <view class="card-image">
        <image class="artifact-img" src="{{item.image}}" mode="aspectFill" />
      </view>
      <!-- 文物名称 -->
      <view class="card-name">
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 底部固定导航栏 -->
  <view class="tab-bar">
    <view class="tab-item" bindtap="goToPage" data-page="home">
      <view class="tab-icon">🏠</view>
      <text class="tab-text">首页</text>
    </view>
    <view class="tab-item" bindtap="goToPage" data-page="guide">
      <view class="tab-icon">🗺️</view>
      <text class="tab-text">导览</text>
    </view>
    <!-- 藏品 - 当前选中态 -->
    <view class="tab-item active">
      <view class="tab-icon">📦</view>
      <text class="tab-text">藏品</text>
      <view class="active-line"></view>
    </view>
    <view class="tab-item" bindtap="goToPage" data-page="my">
      <view class="tab-icon">👤</view>
      <text class="tab-text">我的</text>
    </view>
  </view>
</view>