/* 文物详情页样式 - pages/detail/detail.wxss */

/* 全局样式 */
page {
  background-color: #F5F0E8;
  height: 100%;
}

.container {
  min-height: 100vh;
  background-color: #F5F0E8;
}

/* ========== 顶部返回栏 ========== */
.header-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  z-index: 100;
  background: linear-gradient(180deg, rgba(245, 240, 232, 0.9) 0%, rgba(245, 240, 232, 0) 100%);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.back-icon {
  font-size: 36rpx;
  color: #5D4E37;
  font-weight: bold;
}

/* ========== 文物大图区域 ========== */
.hero-image {
  width: 100%;
  height: 55vh;
  background-color: #F0EBE0;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.placeholder-icon {
  font-size: 150rpx;
}

.detail-img {
  width: 100%;
  height: 100%;
}

/* ========== 文物信息区域 ========== */
.info-section {
  background-color: #FFFDF8;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  padding: 40rpx 30rpx 60rpx;
  min-height: 45vh;
}

/* 文物名称 */
.artifact-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #5D4E37;
  margin-bottom: 20rpx;
}

/* 地点信息 */
.location {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.location-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 26rpx;
  color: #A89070;
}

/* ========== Tab 标签栏 ========== */
.tab-header {
  display: flex;
  border-bottom: 1rpx solid #E8E0D5;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  position: relative;
}

.tab-label {
  font-size: 28rpx;
  color: #A89070;
  transition: color 0.2s ease;
}

/* 选中态 */
.tab-item.active .tab-label {
  color: #5D4E37;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #8B7355;
  border-radius: 2rpx;
}

/* ========== Tab 内容区域 ========== */
.content-area {
  height: 300rpx; /* 可根据需要调整 */
}

.tab-content {
  padding: 10rpx 0;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #6B5D4D;
}